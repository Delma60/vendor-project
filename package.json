{
  "name": "foodconnect-web-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:seller": "npm run dev -w apps/web-seller",
    "dev:admin": "npm run dev -w apps/web-admin",
