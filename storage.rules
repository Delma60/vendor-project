rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /seller-documents/{sellerId}/{fileName} {
      allow read: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.uid == sellerId);
      allow write: if request.auth != null && request.auth.uid == sellerId;
    }
    match /menu-photos/{sellerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == sellerId || request.auth.token.role == 'admin');
    }
  }
}